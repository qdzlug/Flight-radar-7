# Copy to .env and fill in your values
# OpenSky credentials (optional — falls back to anonymous if empty)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ADS-B sources in merge priority order
ADSB_SOURCES=adsb.im,adsb.lol,adsb.fi

# adsb.im feeder URL (skipped if empty), e.g. http://adsb-feeder.local/v2
ADSB_IM_URL=

# FlightAware AeroAPI key for flight enrichment (optional)
FLIGHTAWARE_API_KEY=
